# Copy to .env and adjust. NEVER commit a real .env.
APP_NAME="JNTUA College Of Engineering Pulivendula Smart Exam Result Management System"
ENVIRONMENT=development
API_PREFIX=/api/v1

# PostgreSQL in production, e.g. postgresql+psycopg://exam:exam@localhost:5432/exam
# SQLite is supported for local verification/tests: sqlite:///./exam.db
DATABASE_URL=postgresql+psycopg://exam:exam@localhost:5432/exam

SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated allowed frontend origins (No trailing slash)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Refresh cookie flags. Secure=true should be used over HTTPS in production.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_NAME=exam_refresh_token

# Institution identity used on hall tickets / certificates
INSTITUTION_NAME="JNTUA College Of Engineering Pulivendula"
INSTITUTION_ADDRESS="Pulivendula, Andhra Pradesh 516390"
CERTIFICATE_VERIFICATION_BASE_URL=http://localhost:5173/verify

# Private directory for uploaded SBI Collect fee receipts
UPLOAD_DIR=./uploads
