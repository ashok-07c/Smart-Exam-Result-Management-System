# Copy to .env.local. Never put secrets here — VITE_ variables are public.
# Live backend (FastAPI). Must include /api/v1.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# "live" (default) talks to the backend. "mock" uses clearly-labelled local demo data.
# A failed live request is NEVER silently replaced with mock data.
VITE_API_MODE=live
